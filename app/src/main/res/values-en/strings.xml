    <!-- Technique Breathing -->
    <string name="technique_breathing_name">2-Minute Breathing</string>
    <string name="technique_breathing_short_desc">Simple breathing exercise that calms your nervous system and reduces anxiety in minutes</string>
    <string name="technique_breathing_desc">When anxiety strikes, your breathing becomes shallow and rapid. This technique teaches you simple breathing patterns that activate your body\'s natural relaxation response.</string>
    
    <!-- Technique Grounding -->
    <string name="technique_grounding_name">5-4-3-2-1 Grounding</string>
    <string name="technique_grounding_short_desc">A sensory technique that pulls you out of anxious thoughts by focusing on what surrounds you now</string>
    <string name="technique_grounding_desc">When anxiety carries you away in spiraling thoughts, this technique firmly brings you back to the present moment using your five senses. It effectively interrupts anxious thought patterns.</string>
    
    <!-- Technique Guided Breathing -->
    <string name="technique_guided_breathing_name">Guided Breathing</string>
    <string name="technique_guided_breathing_short_desc">Step-by-step breathing patterns to slow your heart rate and reduce tension</string>
    <string name="technique_guided_breathing_desc">A series of structured breathing exercises that guide you through different techniques, from simple to advanced, to master breathing control and your mental state.</string>
    
    <!-- Technique Progressive Muscle -->
    <string name="technique_progressive_muscle_name">Progressive Muscle Relaxation</string>
    <string name="technique_progressive_muscle_short_desc">Systematically tense and release muscle groups to free physical tension and anxiety</string>
    <string name="technique_progressive_muscle_desc">This classic technique teaches you to identify and release physical tension by contracting then releasing different muscle groups, creating deep whole-body relaxation.</string>
    
    <!-- Technique Peaceful Visualization -->
    <string name="technique_peaceful_visualization_name">Peaceful Visualization</string>
    <string name="technique_peaceful_visualization_short_desc">Guide your mind to a calm and safe place to create a sense of inner peace</string>
    <string name="technique_peaceful_visualization_desc">Use the power of your imagination to create a soothing mental refuge. This technique transports you to peaceful environments that can be revisited whenever needed.</string>
    
    <!-- Technique Thought Labeling -->
    <string name="technique_thought_labeling_name">Thought Labeling</string>
    <string name="technique_thought_labeling_short_desc">Observe and categorize your anxious thoughts to reduce their emotional impact</string>
    <string name="technique_thought_labeling_desc">By learning to observe your thoughts like a neutral scientist, you can reduce their emotional charge and develop a more balanced perspective on your concerns.</string>
    
    <!-- Technique Bubble Stress -->
    <string name="technique_bubble_stress_name">Stress Relief Bubbles</string>
    <string name="technique_bubble_stress_short_desc">A playful and soothing interaction to release stress through simple gestures</string>
    <string name="technique_bubble_stress_desc">Combine play and relaxation with this interactive activity that transforms tension into pleasure, offering therapeutic distraction during difficult moments.</string>
    
    <!-- Technique Sound Therapy -->
    <string name="technique_sound_therapy_name">Sound Therapy</string>
    <string name="technique_sound_therapy_short_desc">Therapeutic sounds and frequencies that calm the mind and promote deep relaxation</string>
    <string name="technique_sound_therapy_desc">Explore the healing power of sound with specially selected frequencies to promote healing, reduce anxiety, and induce deep meditative states.</string>
    
    <!-- Technique Stress Ball -->
    <string name="technique_stress_ball_name">Stress Ball</string>
    <string name="technique_stress_ball_short_desc">Interactive physics with a virtual stress ball to release tensions</string>
    <string name="technique_stress_ball_desc">Use this tactile simulation to channel and release nervous energy through physical interaction, providing immediate outlet for accumulated stress.</string>
    
    <!-- More techniques... -->
    <string name="technique_breathing_stress_15_name">Anti-stress breathing (1-5)</string>
    <string name="technique_breathing_stress_15_short_desc">Breathing technique counting 1-5 to regain calm during stress peaks</string>
    <string name="technique_breathing_stress_15_desc">A quick and effective method using simple breathing countdown to immediately interrupt stress reactions and restore calm state.</string>
    
    <string name="technique_respiration_e12_name">Diaphragmatic (abdominal) breathing</string>
    <string name="technique_respiration_e12_short_desc">Deep breathing technique with the diaphragm to calm the mind and prevent hyperventilation</string>
    <string name="technique_respiration_e12_desc">Learn to breathe with your diaphragm rather than your chest to maximize oxygenation and activate your body\'s natural relaxation response.</string>
    
    <string name="technique_autogenic_training_name">Autogenic Training</string>
    <string name="technique_autogenic_training_short_desc">Deep relaxation method using self-suggestion to create sensations of heaviness and warmth</string>
    <string name="technique_autogenic_training_desc">A physician-developed self-hypnosis technique that uses self-suggestion phrases to induce deep and restorative relaxation state.</string>
    
    <string name="technique_breathing_box_name">Box Breathing</string>
    <string name="technique_breathing_box_short_desc">4-4-4-4 breathing technique used by special forces to quickly regain calm</string>
    <string name="technique_breathing_box_desc">Also known as tactical breathing, this proven method is used by military and first responders to maintain calm under pressure.</string>
    
    <string name="technique_breathing_478_name">4-7-8 Breathing</string>
    <string name="technique_breathing_478_short_desc">Dr. Weil\'s technique for falling asleep: inhale 4s, hold 7s, exhale 8s</string>
    <string name="technique_breathing_478_desc">Developed by Dr. Andrew Weil, this powerful technique can induce relaxation in under a minute and is particularly effective for falling asleep.</string>
    
    <string name="technique_body_scan_meditation_name">Body Scan</string>
    <string name="technique_body_scan_meditation_short_desc">Mindfulness meditation that scans the body to develop body awareness and release tensions</string>
    <string name="technique_body_scan_meditation_desc">A fundamental meditative practice that develops body awareness by systematically directing attention through each part of the body.</string>
    
    <string name="technique_mindful_breathing_name">Mindful Breathing</string>
    <string name="technique_mindful_breathing_short_desc">Mindfulness meditation that develops presence by simply observing natural breath</string>
    <string name="technique_mindful_breathing_desc">The foundation of all mindfulness practice, this meditation teaches you to be present by observing your natural breathing without modifying it.</string>
    
    <string name="technique_loving_kindness_meditation_name">Loving-Kindness Meditation</string>
    <string name="technique_loving_kindness_meditation_short_desc">Metta meditation that cultivates compassion for oneself and others to reduce emotional stress</string>
    <string name="technique_loving_kindness_meditation_desc">This traditional Buddhist practice develops compassion and self-love, creating a powerful antidote to self-criticism and social anxiety.</string>
    
    <string name="technique_auto_hypnosis_autogenic_name">Autogenic Self-Hypnosis</string>
    <string name="technique_auto_hypnosis_autogenic_short_desc">Self-hypnotic induction technique combining autogenic training and suggestions for deep relaxation</string>
    <string name="technique_auto_hypnosis_autogenic_desc">An advanced approach combining autogenic training principles with self-hypnosis to achieve exceptionally deep relaxation states.</string>
    
    <string name="technique_forest_immersion_nature_name">Forest Immersion</string>
    <string name="technique_forest_immersion_nature_short_desc">Immersive mental escape into a forest environment with 3D sounds and sensory guidance</string>
    <string name="technique_forest_immersion_nature_desc">Inspired by Japanese \"forest bathing\" (shinrin-yoku), this immersive experience transports you to a soothing forest environment to reduce stress and restore mental balance.</string>
    
    <string name="technique_meditation_breath_awareness_name">Breath Awareness Meditation</string>
    <string name="technique_meditation_breath_awareness_short_desc">Mindfulness meditation using natural breathing as anchor to develop present attention</string>
    <string name="technique_meditation_breath_awareness_desc">A classic meditation that uses breathing as an anchoring point to develop concentration and presence, the foundation of all contemplative practice.</string>
